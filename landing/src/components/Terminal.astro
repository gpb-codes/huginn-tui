<script>
  const tBtns = document.querySelectorAll("[data-ttab]");
  const tPanes = document.querySelectorAll("[data-tpane]");
  tBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      tBtns.forEach((b) => b.setAttribute("aria-selected", "false"));
      btn.setAttribute("aria-selected", "true");
      const id = btn.getAttribute("data-ttab");
      tPanes.forEach((p) => p.classList.toggle("active", p.getAttribute("data-tpane") === id));
    });
  });
</script>
