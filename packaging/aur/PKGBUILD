# PKGBUILD para AUR: huginn-tui (Huginn — Agent Vault Intelligence).
#
# PRERREQUISITO: debe existir el release v0.2.0 en
# https://github.com/gpb-codes/huginn-tui/releases con los assets
# huginn-linux-amd64.tar.gz y huginn-linux-arm64.tar.gz.
# Sin ese release, `makepkg` falla con error honesto (prohibido el éxito falso).
#
# CÓMO RELLENAR LOS SHA256: deja 'PON_TU_SHA256_AQUI', ejecuta `updpkgsums`
# en el directorio del PKGBUILD y makepkg actualizará los hashes solo.
#
# NOTA: este PKGBUILD no instala nada por sí solo desde este repo.
# Hay que subirlo a AUR (paquete `huginn-tui`) y entonces instalar con:
#   paru -S huginn-tui

pkgname=huginn-tui
# pkgver sin la `v` (el tag del release es v0.2.0; ver palette.go: const VERSION).
pkgver=0.2.0
pkgrel=1
pkgdesc="Huginn — Agent Vault Intelligence (TUI)"
arch=('x86_64' 'aarch64')
url="https://github.com/gpb-codes/huginn-tui"
# Licencia privativa del repo (ver LICENSE).
license=('custom')
depends=('glibc')
optdepends=()
# Un tarball por arquitectura (los assets del release v0.2.0).
source_x86_64=("huginn-linux-amd64.tar.gz::https://github.com/gpb-codes/huginn-tui/releases/download/v0.2.0/huginn-linux-amd64.tar.gz")
source_aarch64=("huginn-linux-arm64.tar.gz::https://github.com/gpb-codes/huginn-tui/releases/download/v0.2.0/huginn-linux-arm64.tar.gz")
# TODO: ejecuta `updpkgsums` para sustituir los placeholders por los hashes reales.
sha256sums_x86_64=('PON_TU_SHA256_AQUI')
sha256sums_aarch64=('PON_TU_SHA256_AQUI')

package() {
  # El tarball contiene un único binario `huginn`: lo instala en /usr/bin.
  install -Dm755 "$srcdir/huginn" "$pkgdir/usr/bin/huginn"
}
